# =============================================================================
# .env.local.example — LOCAL development template (safe placeholder values)
# =============================================================================
# Copy to .env for a local Docker run:  cp .env.local.example .env
# These values boot the full stack (db, redis, elasticsearch, minio, backend,
# frontend, nginx, livekit). External AI/voice/OAuth features need real keys
# but are NOT required to run and browse the site locally.
# Access the site through the Nginx gateway at http://localhost:8080
# NEVER commit a real .env — it is gitignored.
# =============================================================================
COMPOSE_PROJECT_NAME=tuyendung_studio_vn
APP_ENV=development
APP_ENVIRONMENT=development
DEBUG=True
STRICT_ENV_VALIDATION=False
APPEND_SLASH=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend,frontend,nginx-gateway,admin.localhost,employer.localhost,.localhost
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://localhost,http://127.0.0.1:8080,http://admin.localhost:8080,http://employer.localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost,http://127.0.0.1:8080

# --- Nginx Gateway ---
NGINX_PORT=8080

# --- Dockerfiles (lightweight dev images locally) ---
FRONTEND_DOCKERFILE=Dockerfile
BACKEND_DOCKERFILE=Dockerfile

# --- Database ---
DB_ENGINE=django.db.backends.mysql
DB_HOST=db
DB_NAME=square_db
DB_USER=root
DB_PASSWORD=local_dev_db_password
DB_PORT=3306

# --- Redis & Celery ---
SERVICE_REDIS_HOST=redis
SERVICE_REDIS_PORT=6379
SERVICE_REDIS_USERNAME=
SERVICE_REDIS_PASSWORD=
SERVICE_REDIS_DB=0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# --- MinIO (S3 Storage) — served locally via nginx /minio/ ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio_local_dev_password
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minio_local_dev_password
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=square
MINIO_SECURE=False
MINIO_PUBLIC_URL=http://localhost:8080/minio
MINIO_CONSOLE_ADDRESS=:9001

# --- Django / OAuth ---
SECRET_KEY=local_dev_secret_key_change_me_0123456789
CLIENT_ID=local_dev_oauth_client_id
CLIENT_SECRET=local_dev_oauth_client_secret
REQUIRE_CLIENT_SECRET=False
AUTO_MIGRATE=1
SYNC_OAUTH_CLIENT=1
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=3

# --- Web client URLs (local) ---
WEB_CLIENT_URL=http://localhost:8080
WEB_JOB_SEEKER_CLIENT_URL=http://localhost:8080
WEB_EMPLOYER_CLIENT_URL=http://localhost:8080

# --- LiveKit (placeholder keys; voice/WebRTC not exercised locally) ---
LIVEKIT_URL=http://livekit:7880
LIVEKIT_PUBLIC_URL=ws://localhost:8080/livekit
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_change_me_0123456789abcdef
LIVEKIT_AGENT_NAME=square-ai-interviewer
INTERVIEW_AGENT_SHARED_SECRET=local_dev_shared_secret_change_me_0123456789
INTERVIEW_AGENT_AUTH_REQUIRED=True
INTERVIEW_AGENT_AUTH_MAX_SKEW_SECONDS=300
BACKEND_API_URL=http://backend:8000/api

# --- AI / STT / TTS (blank = disabled; set real MetaConnect keys to enable) ---
AI_LLM_BASE_URL=https://api.metaconnect.vn/v1
AI_LLM_MODEL=llm-fast
AI_LLM_API_KEY=
AI_STT_BASE_URL=https://api.metaconnect.vn/v1
AI_STT_MODEL=asr-vi
AI_STT_API_KEY=
AI_TTS_BASE_URL=https://api.metaconnect.vn/v1
AI_TTS_MODEL=tts-vi
AI_TTS_DEFAULT_VOICE=Ly
AI_TTS_API_KEY=

# --- Email (blank = console/no-op locally) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Frontend NEXT_PUBLIC_* (local) ---
NEXT_PUBLIC_NODE_ENV=development
NEXT_PUBLIC_PROJECT_HOST_NAME=localhost
NEXT_PUBLIC_ADMIN_PROJECT_HOST_NAME=admin.localhost
NEXT_PUBLIC_EMPLOYER_PROJECT_HOST_NAME=employer.localhost
NEXT_PUBLIC_PROJECT_SERVER_CLIENT_ID=local_dev_oauth_client_id
NEXT_PUBLIC_MINIO_PUBLIC_URL=http://localhost:8080/minio
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:8080/livekit
NEXT_PUBLIC_DISABLE_INTERVIEW_AGENT_UI=true
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOONGAPI_KEY=
NEXT_PUBLIC_HRM_PUBLIC_URL=http://localhost:8081
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_FORCE_LONG_POLLING=true

# --- Security (relaxed for local http) ---
USE_X_FORWARDED_HOST=True
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
