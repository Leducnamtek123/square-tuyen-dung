# =============================================================================
# api/Dockerfile.prod — Production (optimized)
# =============================================================================
FROM mcr.microsoft.com/playwright/python:v1.49.1-jammy

# Prevent .pyc files and enable unbuffered output
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Install system dependencies
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential python3-dev libssl-dev libffi-dev \
        libopenblas-dev default-libmysqlclient-dev \
        pkg-config curl netcat-traditional openssh-client && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies first (layer caching)
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir -r requirements.txt

# Copy the application code
COPY . .

# Ensure STATIC_ROOT exists to avoid WhiteNoise warnings
RUN mkdir -p /app/staticfiles

# Ownership for the preconfigured non-root user in the Playwright base image
RUN chown -R pwuser:pwuser /app

# Switch to non-root user
USER pwuser

EXPOSE 8000

CMD ["sh", "docker-entrypoint.sh", "gunicorn", "--bind", "0.0.0.0:8000", "--workers", "3", "--timeout", "30", "config.wsgi:application"]
